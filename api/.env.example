APP_NAME=ame-clinica
APP_ENV=local
APP_KEY=
# APP_DEBUG=true SÓ em dev local — nunca em staging/produção (vaza stack trace/SQL)
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB do docker-compose.yml da raiz (porta 3312 em loopback).
# Os valores devem casar com os do compose (DB_USERNAME/DB_PASSWORD/DB_PORT).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3312
DB_DATABASE=ame_clinica
DB_USERNAME=ame
DB_PASSWORD=ame_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
# false SÓ em dev http local; true em qualquer ambiente com https
SESSION_SECURE_COOKIE=false

# SPA dev roda em localhost:5173 (Vite) — a porta faz parte do domínio stateful
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Origens aceitas em requisição de outra origem (change cadastro-online-do-paciente). NUNCA `*`:
# a rota pública humana não tem sessão, logo não tem CSRF, e origem aberta deixaria um site
# hostil usar os próprios visitantes como remetentes. Em produção o SPA é servido do mesmo host
# da API e nada aqui é usado.
CORS_ORIGENS=http://localhost:5173,http://127.0.0.1:5173
# Tetos da rota pública humana, por minuto. Dois eixos: por origem e por endereço — só por origem,
# a barreira se contorna distribuindo o envio.
SECURITY_THROTTLE_PUBLICO_IP=20
SECURITY_THROTTLE_PUBLICO_LINK=60

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================================
# Endurecimento de rede (Fase 6 — pré-VPS). Local-first: NÃO defina nada aqui;
# os defaults já são seguros (nenhum proxy confiado, HSTS desligado).
# ==========================================================================

# Rate limit das rotas AUTENTICADAS (por usuário/min). Buckets separados
# leitura×mutação: ler nunca esfomeia escrever. Comentado/ausente = default do código
# (120/60); definir com valor — nunca vazio (o código blinda vazio→default, mas evite).
# SECURITY_THROTTLE_LEITURA=120
# SECURITY_THROTTLE_MUTACAO=60
# Balde próprio do painel do profissional (a leitura mais cara), por usuário/min.
# SECURITY_THROTTLE_PAINEL_PROFISSIONAL=20

# Confiança de proxy (TRUSTED_PROXIES). Local-first = VAZIO (o IP da conexão já é
# real). No VPS, o IP/faixa EXATA do reverse proxy — nunca "*" (confiar em todos
# deixa forjar X-Forwarded-For e gravar IP falso na auditoria; "*" FALHA a boot).
# Precisa ser variável de ambiente REAL do servidor — no `environment:` do compose,
# NÃO só neste arquivo. Motivo: o trustProxies() roda antes do Dotenv, então lê apenas
# variável de processo; escrita só no .env, ela chega como NULL e a lista sai vazia.
# Isso NÃO tem relação com config:cache — acontece com ele e sem ele.
# Ex.: TRUSTED_PROXIES=10.0.0.1  ou  TRUSTED_PROXIES=172.18.0.0/16
# TRUSTED_PROXIES=

# HSTS: só sob deploy HTTPS. Trava dupla no middleware — só emite se true E a
# conexão for segura (isSecure() via X-Forwarded-Proto do proxy TLS). Nunca em dev.
# SECURITY_HSTS=false

# --- Acoplamento de DEPLOY (ligar um sem os outros é incoerente) ---
# SECURITY_HSTS=true  ⟺  SESSION_SECURE_COOKIE=true  ⟺  APP_DEBUG=false
#   HSTS sem HTTPS não faz sentido; cookie não-secure sob HTTPS vaza sessão;
#   APP_DEBUG=true em produção vaza stack trace/SQL (e a query string) nas telas de erro.
#
# --- Topologia SAME-ORIGIN (obrigatória no VPS) ---
# SPA (web/) e API (api/) DEVEM servir sob o MESMO host, via reverse proxy
# (ex.: app.clinica.com/ → SPA, app.clinica.com/api → API). Origens distintas
# quebram o Sanctum stateful (sessão+CSRF por cookie same-site) e tornam o CORS
# default ("*") errado. Ajuste SANCTUM_STATEFUL_DOMAINS e SESSION_DOMAIN ao host real.
#
# --- Proxy: NÃO logar a query string (LGPD — nome de menor na busca) ---
# O app já não registra a query string nos próprios logs (garantido por teste).
# O reverse proxy do VPS DEVE ser configurado para NÃO logar / fazer scrub da query
# string no access log (ex.: nginx: logar $uri em vez de $request; remover ?busca=).

# ─── WhatsApp Cloud API (change mensageria-whatsapp) ─────────────────────────
# A CREDENCIAL DA CLÍNICA NÃO MORA AQUI. Access Token, App Secret e Verify Token
# são gravados PELA TELA (Configurações → WhatsApp da clínica), cifrados em
# `whatsapp_conexoes` — conectar o canal não pode exigir deploy, e a clínica não
# tem quem o faça. O que fica aqui é só INFRAESTRUTURA.
#
# WHATSAPP_VERSAO_GRAPH=v21.0     # a Meta aposenta versões com data marcada
# WHATSAPP_TIMEOUT=10             # curto de propósito: o envio roda em Job
# WHATSAPP_TENTATIVAS=5
# WHATSAPP_MIDIA_MAX_BYTES=16777216
# WHATSAPP_DISCO_MIDIA=local      # fora do alcance público (documento de MENOR)
# WHATSAPP_THROTTLE_WEBHOOK=300   # balde PRÓPRIO, separado dos de leitura/escrita
# WHATSAPP_RETENCAO_EVENTOS_DIAS=30
#
# --- Operação OBRIGATÓRIA no VPS (sem isto, nada acontece e o silêncio é total) ---
# 1) worker de fila supervisionado:  php artisan queue:work --tries=5
# 2) agendador no cron:              * * * * * php artisan schedule:run
# 3) webhook publicado em HTTPS:     https://SEU-DOMINIO/api/webhooks/whatsapp
#    O proxy NÃO pode reescrever o corpo da requisição: a assinatura da Meta é
#    calculada sobre os BYTES CRUS, e reformatar o JSON invalida toda entrega.
# Passo a passo completo: docs/runbook-whatsapp.md
