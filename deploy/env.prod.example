# Copy to deploy/.env (never commit it). Used by docker compose AND injected into the app.
APP_NAME="Ame Clínica"
APP_ENV=production
# php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=
APP_DEBUG=false
APP_URL=https://ame.gestaonossa.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
# Allows `php artisan demo:popular` in production. Keep false once real patients exist.
APP_DEMO=true

# loopback port the host proxy points to
APP_PORT=8090
TRUSTED_PROXIES=172.31.90.0/24

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_DATABASE=ame_clinica
DB_USERNAME=ame
# strong random password
DB_PASSWORD=
# strong random password
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=ame.gestaonossa.com.br
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=ame.gestaonossa.com.br
CORS_ORIGENS=https://ame.gestaonossa.com.br
SECURITY_HSTS=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
